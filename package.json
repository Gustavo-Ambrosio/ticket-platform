{
  "name": "green-culture-ingressos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite scripts/local-server.js",
    "dev:cloudflare": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --experimental-sqlite --test test/*.test.js",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/admin.js && node --check public/pedido.js"
  },
  "dependencies": { "qrcode-generator": "^2.0.4" },
  "devDependencies": { "wrangler": "^4.0.0" }
}
