{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "green-culture-ingressos",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "APP_URL": "https://green-culture-ingressos.ancestralculturemusic.workers.dev",
    "SALES_ENABLED": "false",
    "MP_ENV": "test"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "green-culture-ingressos", "database_id": "5d040ea5-39c4-4334-8077-f92cba8d0e21", "migrations_dir": "migrations" }]
}
